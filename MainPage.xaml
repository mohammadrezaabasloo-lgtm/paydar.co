<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PMEquipment.MainPage"
             Title="PM تجهیزات">
    <Grid RowDefinitions="Auto,*" Padding="0">
        <Grid Grid.Row="0" BackgroundColor="#17365D" Padding="10" ColumnDefinitions="*,Auto">
            <Label Text="نرم‌افزار PM تجهیزات" TextColor="White"
                   FontAttributes="Bold" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="بارگذاری مجدد" Clicked="OnReloadClicked"
                    BackgroundColor="#315A87" TextColor="White" />
        </Grid>
        <WebView x:Name="AppWebView" Grid.Row="1" />
    </Grid>
</ContentPage>
